{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#1B3A4B", "name": "Primary" },
				{ "slug": "accent", "color": "#C9A227", "name": "Accent" },
				{ "slug": "cream", "color": "#FAF7F0", "name": "Cream" },
				{ "slug": "forest", "color": "#2D5A3D", "name": "Forest" },
				{ "slug": "ink", "color": "#1A1A1A", "name": "Ink" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "Georgia, 'Times New Roman', serif",
					"slug": "serif",
					"name": "Serif"
				},
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"slug": "sans",
					"name": "Sans"
				}
			]
		},
		"layout": {
			"contentSize": "48rem",
			"wideSize": "72rem"
		}
	},
	"styles": {
		"color": {
			"background": "#FAF7F0",
			"text": "#1A1A1A"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "1.0625rem",
			"lineHeight": "1.65"
		}
	}
}
